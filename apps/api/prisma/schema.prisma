/* ==========================================================================
   悟空数学 · 数据模型
   --------------------------------------------------------------------------
   这份是给**生产 MySQL 8** 用的，是唯一源头。
   本地开发跑的是**从这份自动生成的 SQLite 版**（见 tools/dev-schema.mjs）。
   规矩：**只改这一份**。生成出来的 prisma/dev/schema.prisma 别手改，下次会被覆盖。

   为什么 kind 用 String 而不是 enum：**SQLite 不支持 enum**（Prisma 明确不支持），
   用了 enum 就会让"一份 schema 同时喂 MySQL 和 SQLite"这条断掉。所以取值约束放在
   zod（接口边界）而不是数据库 —— 这也正是 §7.1「入参走 zod」那条规矩要管的事。
   ========================================================================== */

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==========================================================================
// M0 · 探活
// ==========================================================================

/// /api/health 会查它。
model HealthCheck {
  id        Int      @id @default(autoincrement())
  note      String   @db.VarChar(191)
  checkedAt DateTime @default(now())

  @@map("health_check")
}

// ==========================================================================
// M1 · 知识结构
// ==========================================================================

/// 知识树的一个节点。
///
/// **一棵自引用树，不做 Stage / Book / Chapter / Section / Point 五张固定表。**
/// 理由是真实数据不是一条直线（见 seed/math-tree.json）：
///   · 竞赛那支是 `track → chapter`，根本没有"年级"这一层
///   · 章下面还挂着 `group`（方法速学 / 易错速析 / 真题速练），group 再挂
///     `method` / `error` / `exam` —— 这三种"卡片桶"在五张表里没地方放
///   · 深度不齐：小学是 学段→年级→册→章→节，竞赛是 竞赛→轨道→章
/// 硬拆成五张表的代价是"382 个节点放不下"，而自引用树的代价只是"类型靠 zod 守"。
model Node {
  id       Int     @id @default(autoincrement())
  /// root | book | chapter | section | point | group | method | error | exam | track
  kind     String  @db.VarChar(16)
  name     String  @db.VarChar(191)
  /// 节 / 知识点 / 卡片的序号
  no       String? @db.VarChar(32)
  /// primary | junior | senior | olympiad（挂在 book / track 上）
  stage    String? @db.VarChar(16)
  /// 出处链接（book / track）
  source   String? @db.VarChar(512)
  /// 领域：数与代数 / 图形与几何 / 统计与概率…（章）
  field    String? @db.VarChar(64)
  /// 中文序号：一 / 二 / 三…（章）
  cn       String? @db.VarChar(16)
  /// 单元标记（章）—— 真实数据里是**布尔值**（89 个章带它），不是字符串。
  /// 一开始写成 String 是照着 String(v) 打印出来的样子猜的，导库时才被 Prisma 拒掉。
  unit     Boolean?
  /// 待核对的说明（章）—— 例如"课本站这一单元只列了单元名，未与教材原书目录逐字核对"
  pending  String? @db.Text
  /// 分组色调：method | error | exam（group）
  tone     String? @db.VarChar(16)
  /// 同一父节点下的次序（前端就是按这个顺序画的）
  order    Int     @default(0)

  parentId Int?
  parent   Node?   @relation("NodeTree", fields: [parentId], references: [id])
  children Node[]  @relation("NodeTree")

  contents Content[]
  cards    Card[]

  /* M3：学习数据也会指向节点（一格记录 / 错题 / 笔记 / 标记） */
  learningRecords LearningRecord[]
  notes           Note[]
  pointMarks      PointMark[]
  /* H：考试切片说"这次考到哪几章" */
  examSliceNodes  ExamSliceNode[]
  examQuestions ExamQuestion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId, order])
  @@index([kind])
  @@map("node")
}

/// 正文。
/// 挂在**任意节点**上 —— 现在唯一一篇真写的挂在「1.2 有理数·数轴」的知识点上，
/// 以后章 / 节也可能有正文，所以不做成"只挂 section"。
model Content {
  id     Int    @id @default(autoincrement())
  nodeId Int
  node   Node   @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  html   String @db.LongText
  /// 一节点多版本，改一次存一版（不覆盖历史）
  version     Int       @default(1)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([nodeId, version])
  @@map("content")
}

/// 卡片类型字典（六类）。现在写死在前端的 learning-dict.json 里，落到库后后台可调。
model CardType {
  name          String @id @db.VarChar(16)
  /// 只在新卡片的默认值上用；真实卡片各自带 weight（同类型也不一样：1.0~1.5）
  defaultWeight Float  @default(1)
  order         Int    @default(0)

  cards Card[]

  @@map("card_type")
}

/// 一个节点上的卡片。
/// 3D 轴"一格按权重切成几块"就靠它（设计稿 §3.4）—— 所以 weight **必须有**。
model Card {
  id     Int  @id @default(autoincrement())
  nodeId Int
  node   Node @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  /// 卡片在节点内的序号（1 起，前端按它排）
  no     Int
  /// 卡片类型；同节点内从 1 开始编号，所以这里是 no 而不是主键
  weight Float @default(1)

  typeName String   @db.VarChar(16)
  type     CardType @relation(fields: [typeName], references: [name])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([nodeId, no])
  @@index([typeName])
  @@map("card")
}

// ==========================================================================
// M2 · 账号与权限
// ==========================================================================

/// 角色。现在两个够用：admin（管理后台）/ student（学生端）。
model Role {
  id          Int              @id @default(autoincrement())
  code        String           @unique @db.VarChar(32)
  name        String           @db.VarChar(64)
  description String?          @db.VarChar(191)
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())

  @@map("role")
}

/// 权限点。
/// **能不能用某个功能，判定必须在服务端**（设计稿 §3.6）—— 前端藏个按钮不算权限，
/// 所以这里存的就是"服务端认的权限点"，接口按它放行或拒绝。
model Permission {
  id    Int              @id @default(autoincrement())
  code  String           @unique @db.VarChar(64)
  name  String           @db.VarChar(64)
  roles RolePermission[]

  @@map("permission")
}

model RolePermission {
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permission")
}

/// 用户。登录名用**账号**（学生端就是这个），不是邮箱 —— 学生不一定有邮箱。
model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique @db.VarChar(64)
  passwordHash String   @db.VarChar(191)
  nickname     String   @db.VarChar(64)
  /// 七年级（下）/ 五年级（上）…… 演示数据里就有这个字段
  grade        String?  @db.VarChar(64)
  /// primary | junior | senior | olympiad —— 与 Node.stage **同一套取值**，不另发明一套。
  /// 为什么不用 grade 文本分组：那是自由文本，「七年级（下）」与「初一」都可能是同一个学段，
  /// 靠字符串匹配分组迟早错。grade 仍然留着显示，但分组一律看 stage。
  stage        String?  @db.VarChar(16)
  /// 班级。**一个学生一个班** —— 真实里学生就在一个教学班；允许跨班的话，
  /// 花名册 / 平均分 / 进度每个数都要先问「算哪个班的」，那点灵活性换不来这份复杂度。
  classId      Int?
  class        Class?   @relation("ClassStudents", fields: [classId], references: [id], onDelete: SetNull)
  roleId       Int
  role         Role     @relation(fields: [roleId], references: [id])

  resets    PasswordReset[]
  sessions  Session[]

  /* M3：一个学生自己的那些东西 */
  learningRecords LearningRecord[]
  exams           Exam[]
  mistakes        Mistake[]
  favorites       Favorite[]
  notes           Note[]
  pointMarks      PointMark[]
  learningProfile LearningProfile?

  /// 这个人是哪些班的班主任（老师账号用）
  teacherOf        Class[] @relation("ClassTeacher")

  /// 他改过谁的数（留痕）
  changesMade      DataChange[] @relation("ChangeActor")
  /// 他的数被谁改过（留痕）
  changesOnMe      DataChange[] @relation("ChangeTarget")

  /* M4 / M5 */
  practiceSessions PracticeSession[]
  posts            Post[]
  replies          Reply[]
  subscriptions    Subscription[]
  orders           Order[]
  examSlices       ExamSlice[]
  examQuestionsCreated ExamQuestion[]

  /// 停用时间。null = 正常。用时间戳而不是布尔标志：顺带记下"什么时候停的"，
  /// 判定就是 `disabledAt !== null`，不会出现"标志位说停用、时间说没停"这种两处对不上的状态。
  disabledAt DateTime?

  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([roleId])
  @@map("user")
}

/// 重置密码的令牌。一次性，用过就作废。
model PasswordReset {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique @db.VarChar(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset")
}

/// 登录会话。
/// 为什么需要它：JWT 是**无状态**的 —— 只 clearCookie 等于只擦了客户端那一份，
/// 令牌本身还能用到过期为止（实测：登出后旧 cookie 仍然能拿到 /api/me）。
/// 共享设备上这就等于"没登出"。所以令牌里带一个 sid，登出即把这行标成已吊销。
model Session {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("session")
}

// ==========================================================================
// M2 续 · 班级（学生管理模块）
// ==========================================================================

/// 一个教学班。**按学段分栏管理**（小学 / 初中 / 高中 / 奥赛），所以 stage 是它的一等字段。
///
/// 班主任指向 User，不另建「老师表」—— 老师要么是能登录的教师账号（role=teacher），
/// 要么这一轮还不支持（先给 ta 建个账号）。
model Class {
  id      Int     @id @default(autoincrement())
  name    String  @db.VarChar(64)
  /// primary | junior | senior | olympiad
  stage   String  @db.VarChar(16)
  /// 年级，例如 五年级（上）/ 七年级（下）。奥赛班没有年级，允许留空
  grade   String? @db.VarChar(64)

  teacherId Int?
  /// onDelete: SetNull —— **删班不该把老师一起删掉**，老师是个人
  teacher   User? @relation("ClassTeacher", fields: [teacherId], references: [id], onDelete: SetNull)

  /// 备注：上课时间、教材版本这类
  note   String? @db.VarChar(5000)
  order  Int     @default(0)
  active Boolean @default(true)

  students User[] @relation("ClassStudents")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stage, order])
  @@map("class")
}

// ==========================================================================
// M2 续 · 后台改学生数据的留痕（模块 E）
// ==========================================================================

/// 后台改动学生数据留下的痕迹。
///
/// **每一次改动都必须写一条**，而且是和改动本身在**同一个事务**里写 ——
/// 这是"允许后台做第二个入口"的前提：学生说"我明明是 85 分"的时候，
/// 要查得出是谁、什么时候、从多少改成了多少、为什么。
///
/// 谁都不能绕过去：编辑一律走 change-log.service 的 applyChange()，
/// 它把"写库"和"写留痕"按一个事务提交 —— 留痕写不进去，改动也一起回滚。
model DataChange {
  id      Int    @id @default(autoincrement())
  /// 同一次保存产生的一批改动共用一个 batchId，回放时能看成"一次操作"
  batchId String @db.VarChar(32)

  actorId Int
  /// **Restrict 而不是 Cascade**：删了执行人，"谁改的"就成空白，而留痕的价值恰恰在那个人身上。
  /// 所以执行过改动的管理员账号删不掉 —— 这是刻意的。
  actor   User @relation("ChangeActor", fields: [actorId], references: [id], onDelete: Restrict)

  /// 改的是**谁的数据**（不是谁改的）。查一个学生的变更历史走这个。
  targetId Int
  /// 学生被删时他的数据一起没了，留痕跟着走是一致的，不会留下指向空学生的孤儿记录。
  target   User @relation("ChangeTarget", fields: [targetId], references: [id], onDelete: Cascade)

  /// learning_record | learning_event | mistake | exam | exam_paper | exam_slice | note | favorite | practice_session
  entity   String  @db.VarChar(32)
  entityId String  @db.VarChar(32)
  /// 给人看的说明（"七年级（上）/ 有理数 / 1.2 数轴"这种），免得回放时看不懂改的是哪一条
  label    String  @db.VarChar(191)
  /// 改动的字段名；删除整条时记 delete
  field    String  @db.VarChar(48)
  oldValue String? @db.Text
  newValue String? @db.Text
  /// 为什么改。允许留空，但界面上要催一下
  reason   String? @db.VarChar(191)

  createdAt DateTime @default(now())

  @@index([targetId, createdAt])
  @@index([actorId, createdAt])
  @@index([batchId])
  @@map("data_change")
}

// ==========================================================================
// M3 · 学习数据（个人中心 / 学习进度 / 错题本 / 时间轴）
// ==========================================================================
//
// 字段形状**照 seed 里现有那两份冻结数据来**（learning-default.json /
// learning-students.json），不另发明一套 —— 时间轴那套视图（2D / 3D）现在读的
// 就是那个形状，接口只要还它原样，视图层一行都不用动。

/// 一格学习记录：一个学生在一个**轴节点**上的掌握情况。
///
/// 注意是"轴节点"不是"树节点"：轴的走法不是把树拍平（point 全上；section 只在
/// 没有 point 子节点时上；chapter 只在没有 section/point 直接子节点时上）。
/// 导库时逐条复刻了 assets/js/timeline-axis.js 的这套走法，卡片与记录都挂在同一批节点上。
model LearningRecord {
  id        Int     @id @default(autoincrement())
  userId    Int
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  nodeId    Int
  node      Node    @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  /// 0~100
  mastery   Int     @default(0)
  /// 未开始 / 学习中 / 初步掌握 / 已掌握 / 精通 / 待复习
  status    String  @db.VarChar(16)
  /// 日期一律存 `YYYY-MM-DD` 字符串，不做成 DateTime：
  /// 冻结数据里就是"日历上的哪一天"，没有时刻也没有时区，转成 DateTime 反而会引入偏差。
  learnedAt String? @db.VarChar(16)
  reviewAt  String? @db.VarChar(16)
  plannedAt String? @db.VarChar(16)
  /// 难度（1~5）
  diff      Float?
  /// 学期，例如 `2020-上`
  term      String? @db.VarChar(16)

  /// 五因子 acc / solo / gap / speed / err。
  /// 存 JSON 文本而不是五列：它只是给雷达图整块读出来用，从来不按单个因子查。
  /// （也没有做成 Json 类型 —— SQLite 那份 schema 由这份生成，少一种类型差异就少一个坑。）
  factors   String? @db.Text

  /// 这个学生在这一格上那几张卡片的**学习状态**（diff / acc / status / at）。
  /// 存 JSON 文本而不是单开一张表：视图是**按下标整块读**的（"第 3 张卡片"），
  /// 从来不按里面的字段查；单开一张表只会把 type / weight 从 Card 重复一份。
  /// 注意别和 Node 上的 Card 弄混：那边是"这一格有哪些卡片"（教学内容，全局一份），
  /// 这边是"这个学生把这几张卡片学到哪儿了"（一人一份）。
  cards     String? @db.Text

  /// 前置没满足（"锁着"的那一格）
  blocked   Boolean @default(false)

  events    LearningEvent[]
  marks     PointMark[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, nodeId])
  @@index([userId, status])
  @@map("learning_record")
}

/// 一格上发生过的事（首学 / 复习 / 纠错 / 考试）—— 时间轴的圆点就是它。
model LearningEvent {
  id       Int            @id @default(autoincrement())
  recordId Int
  record   LearningRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  /// 毫秒时间戳。2020 年的毫秒数有 13 位，超过 Int 的 32 位上限，所以用 BigInt
  /// （MySQL BIGINT / SQLite INTEGER）。出口统一转成 Number 再吐给前端。
  at       BigInt
  /// first | review | fix | exam
  kind     String  @db.VarChar(16)
  mastery  Int     @default(0)

  /// 只有 exam 事件有：哪一场、考了多少
  examCode String? @db.VarChar(16)
  score    Int?
  full     Int?
  /// 只有 fix 事件有：这一题卷面拿了多少 / 满分多少
  /// （照 assets/js/timeline-data.js 的 attachExams() 原样：`from: item.score, to: item.full`）
  fromVal  Int?
  toVal    Int?

  @@index([recordId])
  @@map("learning_event")
}

/// 一场考试。
model Exam {
  id      Int    @id @default(autoincrement())
  userId  Int
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// `E1`…`E15`（冻结数据里的编号）
  code    String @db.VarChar(16)
  name    String @db.VarChar(191)
  at      BigInt
  date    String @db.VarChar(16)
  /// 这场考试覆盖轴上第几格到第几格
  fromIdx Int
  toIdx   Int
  /// unit | mid | final …
  scope   String @db.VarChar(16)

  papers  ExamPaper[]

  createdAt DateTime @default(now())

  @@unique([userId, code])
  @@index([userId])
  @@map("exam")
}

/// 卷面上的一道题。`card` 是它考的是那一格里的第几张卡片。
model ExamPaper {
  id     Int  @id @default(autoincrement())
  examId Int
  exam   Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  /// 这场考试覆盖轴上第几格到第几格（0 起）
  index  Int
  /// 这道题考的是**哪个节点**。存 id 而不是只存"第几格"：
  /// 后台改一次树，格子的下标就会平移，只记数字的话卷面就指到隔壁题上了。
  /// **普通列，不是外键** —— 卷面是历史记录，节点删了它也该留着。
  nodeId Int?
  full   Int
  score  Int
  card   Int
  /// 还考到了别的格（JSON 数组）；空就是没有
  also   String? @db.Text
  /// 错因（JSON 数组）。**这一列是"是不是错题"的判据** —— 见 Mistake 的注释
  causes String? @db.Text

  @@index([examId])
  @@map("exam_paper")
}

/// 错题。
///
/// **判据是"卷面这道题带错因"，不是"没拿满分"。** 这两件事差别很大：
/// 冻结数据里 812 道卷面题有 807 道 score < full（9/10 这种），只有 158 道带 causes ——
/// 而独立数出来的 fix 事件也正好是 158 个。按"没满分"算错题，错题本一上来就 807 条，
/// 全站也就没有"错题"这个概念了。
model Mistake {
  id         Int    @id @default(autoincrement())
  userId     Int
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// exam（考试卷面上错的）| practice（练习里错的）
  /// 为什么要这个判别列：两种错题的字段形状**不一样** ——
  /// 考试错的能指到"轴第几格 / 第几张卡片 / 得几分"，练习错的没有卷面，那几样全是空。
  /// 不判别就只能给练习错题编一个假考号，错题本上就会冒出根本不存在的考试。
  source     String @default("exam") @db.VarChar(16)

  /// 挂在哪个知识点上（练习错题可能压根挂不上 —— 题目没绑节点）。
  /// **普通列，不是外键**：删一个知识点不该把学生的错题记录一起删掉（那是数据丢失），
  /// 所以这里存 id + 一份名字快照，节点没了名字还在，错题本照样读得出来。
  nodeId     Int?
  nodeName   String @default("") @db.VarChar(191)

  examCode   String? @db.VarChar(16)
  /// 这一格在**轴上第几格**（不是"卷面上第几题" —— 冻数据里的字段名就叫 index，
  /// 而 assets/js/timeline-data.js:335 是拿它当 records 的下标用的）
  cellIndex  Int?
  cardNo     Int?
  /// 错因（JSON 数组）。考试那份元素形如 `{ card, key, by, acc, k }`；练习那份只有 key
  causes     String? @db.Text
  /// 只有练习错题用得上：直接记题号与答了什么
  questionId Int?
  given      String? @db.VarChar(191)
  score      Int?
  full       Int?
  at         BigInt
  /// open（还没订正）/ fixed（订正过）
  status     String @default("open") @db.VarChar(16)

  createdAt  DateTime @default(now())

  @@index([userId, status])
  @@index([userId, source])
  @@map("mistake")
}

/// 收藏。能收的不止知识点（还有方法、公式、帖子、题），所以 refId 是字符串，不是外键。
model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// point | method | formula | post | question
  kind      String   @db.VarChar(16)
  refId     String   @db.VarChar(64)
  title     String   @db.VarChar(191)
  sub       String?  @db.VarChar(191)

  createdAt DateTime @default(now())

  @@unique([userId, kind, refId])
  @@index([userId])
  @@map("favorite")
}

/// 笔记。可以挂在某个知识点上，也可以是一篇自由的（nodeId 为空）。
model Note {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nodeId    Int?
  node      Node?    @relation(fields: [nodeId], references: [id], onDelete: SetNull)

  title     String   @db.VarChar(191)
  body      String   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("note")
}

/// 掌握标记（重点 / 难点 / 待复习 / 前置未满足）。
///
/// 独立成表而**不是**在 LearningRecord 上再塞一个 JSON 列：标记是要"按标记筛"的
/// （"把标了难点的都调出来"），JSON 列筛不了。一份数据只有一个出处。
model PointMark {
  id       Int            @id @default(autoincrement())
  recordId Int
  record   LearningRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  userId   Int
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  nodeId   Int
  node     Node           @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  /// key | hard | review | block
  mark     String  @db.VarChar(16)
  createdAt DateTime @default(now())

  @@unique([userId, nodeId, mark])
  @@index([userId, mark])
  @@map("point_mark")
}

/// 一个学生的学习面板设置。
///
/// 现在只放一件东西：时间轴上"今天"那条线画在哪儿。
/// 为什么不直接取服务器的当前日期 —— 演示数据是**按冻结的今天（2026-06-30）生成的**，
/// 考试日期、复习节奏全围着它排；换一个真实的今天，那条线就会跑到所有考试后面去，
/// 时间轴看着就空了。所以这个值跟数据走，一个学生一份。
model LearningProfile {
  userId    Int      @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  todayAt   String   @db.VarChar(16)
  updatedAt DateTime @updatedAt

  @@map("learning_profile")
}

// ==========================================================================
// M4 · 题库与做题
// ==========================================================================
//
// 题库有两种东西，**必须分开**：
//   · 可判分的题（`choice` / `blank`）—— 现在是 practice.html 里那 4 道，带正确选项与解析。
//     抽进了 seed/practice-questions.json（导出的不是"再写一遍"，是从 HTML 原样抠的）。
//   · 只有题面的题（`board`）—— 白板题库那 58 条，`{id, book, chapter, text}`，**没有答案**。
//     它做不了"判分"，所以 kind 上标清楚；硬把它当练习题，一提交只能全判错。
//   为什么非要这样分：这一版全站唯一一份**可判分**的题就是那 4 道。
//   往后要扩题，就照 practice-questions.json 的形状往里加，不用改接口。

/// 一道题。
model Question {
  id          Int     @id @default(autoincrement())
  /// choice（单选）| blank（填空）| board（只有题面，判不了分）
  kind        String  @db.VarChar(16)
  /// 稳定编号：练习题 `p1`…，白板题用它原来的 id（`7a-01`）
  code        String  @unique @db.VarChar(32)
  /// 考点标签（练习题的 `quiz-tag`）
  tag         String? @db.VarChar(191)
  /// 题干（原样 HTML，和正文同一规矩：前端把它塞回容器就能渲染得一字不差）
  stem        String  @db.Text
  /// 选项，JSON 数组 `[{ key: 'A', text: '…' }]`
  options     String? @db.Text
  /// 填空格的说明，JSON 数组 `[{ label: '系数', answer: '-3' }]`
  blanks      String? @db.Text
  /// 正确答案：单选 = `B`；多空 = `-3|3`（竖线分隔，顺序对应空格）；board = null
  answer      String? @db.VarChar(64)
  explanation String? @db.Text
  /// 收录来源：`practice.html` / `whiteboard-problems.js`
  source      String? @db.VarChar(64)
  order       Int     @default(0)

  answers     PracticeAnswer[]

  createdAt   DateTime @default(now())

  @@index([kind])
  @@map("question")
}

/// 一次练习（点一次"开始练"就是一条）。
/// 为什么要有"会话"而不是直接交答案：**题目和答案是分开取的** ——
/// 取题时不许把 answer 带给前端（那等于把答案连同链接一起发出去），
/// 所以判分只能发生在服务端，而服务端得先记住"这一次发了哪几道题给谁"。
model PracticeSession {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  total       Int      @default(0)
  /// 对了几道（提交后才有）
  correct     Int?
  /// 其中**判得了分**的有几道（提交后才有）。
  /// 白板题（kind=board）只有题面、没有答案 —— 它们记「做了」但不参与判分，
  /// 所以正确率的分母只能是这一列，不能拿 total 当分母（那等于把白板题全判成错的）。
  judged      Int?
  submittedAt DateTime?

  answers     PracticeAnswer[]

  createdAt   DateTime @default(now())

  @@index([userId])
  @@map("practice_session")
}

model PracticeAnswer {
  id         Int              @id @default(autoincrement())
  sessionId  Int
  session    PracticeSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId Int
  question   Question         @relation(fields: [questionId], references: [id], onDelete: Cascade)

  /// 学生答的：单选 `B`；多空 `-3|3`
  given      String?  @db.VarChar(191)
  /// 判分结果（服务端算的，前端说了不算）
  correct    Boolean?
  order      Int      @default(0)

  @@unique([sessionId, questionId])
  @@index([sessionId])
  @@map("practice_answer")
}

// ==========================================================================
// M5 · 论坛
// ==========================================================================
//
// 演示数据原来存在 **localStorage** 里（assets/js/forum.js 拿它当库），
// 所以"换个浏览器登录，帖子还在"这件事原来做不到 —— 存进库才做得到。

model Board {
  id    Int     @id @default(autoincrement())
  /// `study` / `help` / `exam`
  code  String  @unique @db.VarChar(32)
  name  String  @db.VarChar(64)
  desc  String? @db.VarChar(191)
  note  String? @db.Text
  order Int     @default(0)

  posts Post[]

  @@map("board")
}

model Post {
  id         Int      @id @default(autoincrement())
  boardId    Int
  board      Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  title      String   @db.VarChar(191)
  body       String   @db.LongText
  /// 发帖人。演示帖的作者**没有账号**，所以 authorId 为空、名字单独存一份。
  authorId   Int?
  author     User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName String   @db.VarChar(64)
  views      Int      @default(0)
  /// 从演示数据搬过来的那条，记一下原来的编号 —— 重导时按它认人，不会重复插
  seedKey    String?  @unique @db.VarChar(64)
  /// 置顶时间。null = 没置顶；管理员置顶后置为当前时间，列表里按它 desc 排前面
  pinnedAt   DateTime?
  /// 加精时间。null = 没加精；管理员加精后置为当前时间，列表里挂个精标
  goodAt     DateTime?

  replies    Reply[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([boardId])
  @@map("post")
}

model Reply {
  id         Int      @id @default(autoincrement())
  postId     Int
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId   Int?
  author     User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName String   @db.VarChar(64)
  /// 演示数据里的身份，例如"热心答主"
  role       String?  @db.VarChar(32)
  text       String   @db.Text
  seedKey    String?  @unique @db.VarChar(64)

  createdAt  DateTime @default(now())

  @@index([postId])
  @@map("reply")
}

// ==========================================================================
// M6 · 会员与套餐
// ==========================================================================
//
// 两个维度分开放：
//   · **套餐 Plan** —— 卖什么、多少钱、买多久。免费 / 半年 / 一年 / 三年都是套餐。
//   · **服务项目 ServiceItem** —— 权益清单里的一行（题库、学习报告、错题本容量…）。
//   中间那张 PlanService 是"某个套餐在这一行上给什么"：给了就是可用，
//   还可以带一个显示值（比如"错题本容量"在免费版是"50 道"、在会员版是"不限"）。
//   为什么不把权益写成一个 JSON 塞在套餐上：那样"改一行对所有套餐生效"就做不到，
//   而这一行以后是要被订单/权益判定引用的（"这个人有没有会员专属题解"）。

/// 套餐。
model Plan {
  id            Int      @id @default(autoincrement())
  /// free | half-year | one-year | three-year
  code          String   @unique @db.VarChar(32)
  name          String   @db.VarChar(64)
  /// 价格，单位**分**。用整数存钱 —— 浮点存金额早晚会差一分钱
  priceCents    Int      @default(0)
  /// 划线原价（0 = 不显示）
  originalCents Int      @default(0)
  /// 时长（天）。0 = 不过期（免费版）
  days          Int      @default(0)
  /// 一句话卖点
  tagline       String?  @db.VarChar(191)
  /// 是否标"推荐"
  featured      Boolean  @default(false)
  /// 是否上架（下架的不在前台出现，但历史订单还指得到它）
  active        Boolean  @default(true)
  order         Int      @default(0)

  services      PlanService[]
  subscriptions Subscription[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([active, order])
  @@map("plan")
}

/// 服务项目：权益对比表里的**一行**。
model ServiceItem {
  id     Int     @id @default(autoincrement())
  /// 稳定编码，例如 question_bank / tutorial_3d
  code   String  @unique @db.VarChar(32)
  name   String  @db.VarChar(64)
  desc   String? @db.VarChar(191)
  order  Int     @default(0)
  active Boolean @default(true)

  plans  PlanService[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("service_item")
}

/// 某个套餐在某一行服务上给什么。
model PlanService {
  planId    Int
  serviceId Int
  plan      Plan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  service   ServiceItem @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  /// 包含了这一项就是 true；false 时前台显示"—"
  included  Boolean @default(true)
  /// 这一格要显示的文字（"50 道" / "不限" / "进阶"）。空着就显示 ✓
  value     String? @db.VarChar(64)
  /// **这一项的数量上限**（错题本 "50 道" 这种）。null = 不限，或这一项不是额度型。
  ///
  /// 为什么不从 value 里把 "50 道" 抠出来当数字用：那等于**改文案就是改行为**。
  /// 运营把"50 道"写成"五十道"，判定就悄悄失效了，而且没人会想到是文案改坏的。
  /// 所以：数字归 quota，文案归 value，两件事各管各的。
  quota     Int?

  @@id([planId, serviceId])
  @@map("plan_service")
}

/// 某个人当前买到的套餐。
///
/// 为什么不是"在 User 上放一个 isVip 字段"：那样说不清"到什么时候为止"，
/// 也没法留历史。到期判定就是拿 endAt 跟当下比，不需要定时任务去改标志位
/// （定时任务一旦漏跑，会员就变成永久的了）。
model Subscription {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId    Int
  plan      Plan      @relation(fields: [planId], references: [id])
  /// 免费版可以不发这条记录；发了就按 endAt = null 表示不过期
  startAt   DateTime  @default(now())
  endAt     DateTime?
  /// active | refunded
  status    String    @default("active") @db.VarChar(16)
  /// 是哪一笔订单开通的。出事时要说得清"你这笔单到底开通了没有"
  orderNo   String?   @db.VarChar(32)

  createdAt DateTime  @default(now())

  @@index([userId, status])
  @@map("subscription")
}

// ==========================================================================
// M6 · 后半：下单与支付
// ==========================================================================

/// 一笔订单。
///
/// 下单那一刻把套餐**快照**下来（名字 / 时长 / 金额），不跟着 Plan 走：
/// 后台改价、改名、甚至下架，都不该影响已经下过的单 ——
/// 否则会出现"用户看着 268，付款时变成 288"这种事。
/// 也**不给 Plan 加外键**：历史订单不该因为删掉一个套餐就读不出来
/// （和 Mistake 那份"名字快照"同一个道理）。
model Order {
  id          Int    @id @default(autoincrement())
  /// 给人看的订单号：CN + 日期 + 随机 6 位。**不拿自增 id 当订单号** ——
  /// 那等于把"总共卖了多少单"写在脸上
  orderNo     String @unique @db.VarChar(32)

  userId      Int
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  planCode    String @db.VarChar(32)
  planName    String @db.VarChar(64)
  /// 买的是多少天（0 = 不过期；但免费版根本不让下单）
  days        Int
  amountCents Int

  /// pending | paid | canceled | expired
  /// **expired 不落库**：读的时候拿 expiresAt 跟当下比现算（和权益到期同一套办法）。
  /// 落了库就要有定时任务去翻它，漏跑一次就永远停在 pending
  status      String @db.VarChar(16) @default("pending")
  /// dev | wxpay | alipay —— dev 是开发用假通道，**生产环境里根本不存在**
  channel     String @db.VarChar(16)

  createdAt   DateTime  @default(now())
  /// 待支付超时。过了它这单就废了，不该再允许支付
  expiresAt   DateTime
  paidAt      DateTime?

  payments    Payment[]

  @@index([userId, status])
  @@map("order")
}

// ==========================================================================
// H · 考试切片（学生自己上传的考试）
// ==========================================================================
//
// 与 `Exam`（演示数据里导入的那 15 场）**是两回事**，互不干扰、也不合并：
//   Exam  —— 历史数据，带卷面题、轴上区间、错题；没人能改它
//   切片  —— 学生自己传的：图片 + 自己框的错题 + 一句"这次的情况"
// 为什么不复用 Exam：Exam 的字段是"从标注数据里推出来的"（覆盖轴区间、卷面题号、
// 每个知识点得分），而学生上传时只知道"哪一天、什么卷、考了多少、错在哪几题"。
// 硬塞进一张表，两边都会多出一堆永远为空的列，而且演示数据会被学生改动。
//
// 上传的图片落在 STORAGE_DIR（见 config.ts），库里只存**相对路径**。

/// 一张考试的切片：一次上传 = 一条。
model ExamSlice {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 考试名称，例如"五年级上 · 第一单元综合素养评价"
  name      String @db.VarChar(191)
  /// 考试那天。**存 `YYYY-MM-DD` 字符串**（和 LearningRecord 同一套）：
  /// 这是"日历上的哪一天"，没有时刻也没有时区，转成 DateTime 反而会引入偏差。
  date      String @db.VarChar(16)
  /// 科目与卷型，例如"数学" + "单元卷 / 期中 / 期末 / 模拟"
  subject   String @db.VarChar(64)
  paperType String @db.VarChar(32)

  /// 得分与满分。**都允许为空**：有时候学生只想知道错在哪，不想填分数；
  /// 而得分率这类统计只在两个都有值时才出现在报告里（不猜、不用 0 顶替）。
  score Int?
  full  Int?

  /// 学生写的那段"这次的情况"
  note String? @db.Text

  images ExamSliceImage[]
  boxes  ExamSliceBox[]
  /// 这次考到了哪几章（学生选）—— 3D 时间轴上就按这个区间落位
  nodes  ExamSliceNode[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
  @@map("exam_slice")
}

/// 切片里的一张图（正面 / 反面 / 附加页）。
model ExamSliceImage {
  id      Int       @id @default(autoincrement())
  sliceId Int
  slice   ExamSlice @relation(fields: [sliceId], references: [id], onDelete: Cascade)

  /// 相对 uploads 根目录的路径。**服务端生成，不接受前端传路径** ——
  /// 让前端给路径等于让人往任意位置写文件。
  file  String @db.VarChar(191)
  label String @db.VarChar(32)
  /// 第几页（0 起）。框上的 `page` 指的就是它。
  order Int    @default(0)
  /// 原始字节数：后台据此判断"这张要不要压缩"
  bytes Int    @default(0)

  @@index([sliceId])
  @@map("exam_slice_image")
}

/// 卷面上一个框 = 一道题。
/// 坐标是**百分比**（相对那张图）—— 与像素尺寸无关，换图、压缩、裁边都不用重算
/// （和演示阶段那份 `exam-scan.js` 同一套口径）。
model ExamSliceBox {
  id      Int       @id @default(autoincrement())
  sliceId Int
  slice   ExamSlice @relation(fields: [sliceId], references: [id], onDelete: Cascade)

  /// 第几页（对应 ExamSliceImage.order）
  page Int
  /// 卷面上的题号
  q    Int
  x    Float
  y    Float
  w    Float
  h    Float

  /// 这道题考的是哪个知识点。**报告里的"薄弱点"全靠它** ——
  /// 不填也能存（框还在），只是那道题不进知识点统计。
  nodeId Int?
  /// 错因（学生自己写的一句）
  cause String? @db.VarChar(191)

  @@index([sliceId])
  @@map("exam_slice_box")
}

/// 这次考到了哪几章。多对多 —— 一场考试常常覆盖好几章。
///
/// 用**真外键 + 级联**（不是普通列）：章被删掉之后，"这次考到了哪一章"就是一句空话，
/// 留着那个 id 只会让时间轴去查一个不存在的节点。和 Mistake 那边（要保住历史名字快照）
/// 不一样 —— 这里没有名字可保，覆盖关系本来就依赖那一章还在。
model ExamSliceNode {
  sliceId Int
  nodeId  Int
  slice   ExamSlice @relation(fields: [sliceId], references: [id], onDelete: Cascade)
  node    Node      @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@id([sliceId, nodeId])
  @@map("exam_slice_node")
}

/// 渠道那边确认收到钱的那条记录。
// ==========================================================================
// B · 真题题库
// ==========================================================================
//
// 与 `Question`（M4 的练习题）**是两回事**，互不合并：
//   Question      —— 演示阶段那 4 道「考点速练」练习题，结构简单、不带年份与章节
//   ExamQuestion  —— 中考 / 高考 / 模拟卷上抠下来的真题：年份、地区、来源、章节、难度
//
// 为什么不复用 Question：
//   1. 字段形状不一样 —— 真题要按"年份 / 地区 / 卷型"筛，练习题不用；
//   2. 真题要绑到知识树的一个**章 / 节 / 点**上做"按章练习"，练习题没有这一层；
//   3. Question 上没有 year / region / paperType / difficulty 这几列，
//      硬加进去那 4 道演示题就全是空值，跟真题混在一起筛不动。
//
// 真题的"题干 / 选项 / 答案 / 解析"字段形状**照 Question 同一套** ——
// stem 是 HTML 文本、options / blanks 是 JSON、answer 是单值或竖线分隔多空。
// 这样判分函数能直接复用 practice 那一份（同一种格式只写一次判分）。

/// 一道真题。
model ExamQuestion {
  id          Int      @id @default(autoincrement())
  /// choice（单选）| blank（填空）| board（只有题面，判不了分）
  /// 和 Question.kind 取值集合**保持一致** —— 判分走同一个函数。
  kind        String   @db.VarChar(16)
  /// 稳定编号：录入时给一个，例如 `2024-bj-01`。不填就由 id 当编号。
  code        String   @unique @db.VarChar(64)
  /// 题干（原样 HTML，和正文同一规矩：塞回容器就一字不差地渲染）
  stem        String   @db.LongText
  /// 选项，JSON 数组 `[{ key: "A", text: "…" }]`；非选择题为空
  options     String?  @db.Text
  /// 填空格说明，JSON 数组 `[{ label: "系数", answer: "-3" }]`
  blanks      String?  @db.Text
  /// 正确答案：单选 = `B`；多空 = `-3|3`；board = null
  answer      String?  @db.VarChar(64)
  /// 解析（HTML）。会员可见，免费看不到 —— 判分在 service 端
  explanation String?  @db.LongText

  /// 年份（4 位，例如 2024）。**整数** —— 给个 0 是"年份不详"，不算 null
  year        Int
  /// 地区 / 城市 / 命题单位：北京 / 上海 / 全国卷Ⅰ / 海淀区二模 …
  region      String   @db.VarChar(64)
  /// 卷型：中考 / 高考 / 模拟 / 期中 / 期末
  paperType   String   @db.VarChar(32)
  /// 题型：选择题 / 填空题 / 解答题 / 证明题 / 综合题（中文，给前台筛）
  qtype       String   @db.VarChar(32)
  /// 难度（1~5）—— 录入时老师估，学生练习后可被实际得分率覆盖（这一版不做）
  difficulty  Int      @default(3)
  /// 题号（卷面上的），例如「第 15 题」—— 录入时可空
  no          String?  @db.VarChar(16)

  /// 这道题挂哪个章节 / 知识点。**真外键 + SetNull**：
  /// 知识点删了，题目也跟着掉挂靠但题面留着 —— 真题是后台录入的内容资产，
  /// 不是学生的学习记录，删管理员不该把题删掉、删节点也不该把题删掉。
  /// （和 Mistake 那种"要保历史名字快照"不一样 —— 这里 nodeId 没了就是没了。）
  nodeId      Int?
  node        Node?    @relation(fields: [nodeId], references: [id], onDelete: SetNull)

  /// 来源备注：哪本教辅、第几页 / 网址 —— 一行自由文本
  source      String?  @db.VarChar(191)

  /// 录入人（管理员）。删管理员不该把题目删掉 —— 这条是内容资产，不是个人数据
  creatorId   Int?
  creator     User?    @relation(fields: [creatorId], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([year])
  @@index([region])
  @@index([paperType])
  @@index([qtype])
  @@index([nodeId])
  @@index([difficulty])
  @@map("exam_question")
}

model Payment {
  id      Int   @id @default(autoincrement())
  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  channel String @db.VarChar(16)
  /// 渠道那边的流水号。**唯一** —— 回调一定会重试，
  /// 靠它把"同一笔钱记两次、权益开两次"挡住
  transactionId String @unique @db.VarChar(64)
  /// 回调里说的金额。**必须跟订单金额对得上**，对不上就拒 ——
  /// 这是"改一个数字就白拿会员"的唯一防线
  amountCents   Int
  /// paid | failed
  status        String @db.VarChar(16)
  /// 回调原文，原样留着：出事只有它能还原"当时到底收到了什么"
  raw           String @db.Text

  createdAt DateTime @default(now())

  @@index([orderId])
  @@map("payment")
}
