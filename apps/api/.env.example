# 复制成 .env 再改。真值不进仓库（.gitignore 已挡）。
NODE_ENV=development
PORT=3000
APP_VERSION=0.0.0

# 本地开发：SQLite 文件 —— 不走网络、不用装数据库服务。
# 注意：路径是相对 **schema 文件所在目录** 解析的，所以这里指 prisma/dev/dev.db
DATABASE_URL="file:./dev.db"

# 上传文件：开发期写本地目录，生产换 oss
STORAGE_DRIVER=local
STORAGE_DIR=./var/uploads

# 生产（MySQL 8）长这样：
# DATABASE_URL="mysql://wukong:改成密码@127.0.0.1:3306/wukong_math"
# STORAGE_DRIVER=oss

# 登录令牌的签名密钥。**上线前必须换掉**（换掉 = 所有人重新登录）
JWT_SECRET=dev-only-change-me-9f3a1c7e
AUTH_COOKIE=wk_token
AUTH_TTL_DAYS=7

# ---- 支付 ----
# 待支付超时（分钟）。过了这单就作废，不留"永远可以支付"的单
PAY_ORDER_TTL_MINUTES=30

# 开发用**假通道**的签名密钥。它在生产环境里根本不会注册，所以这个默认值本身不危险；
# 它的作用是让"伪造回调必须被拒"这条能在这里先被真测一遍。
# 真接微信之后，商户凭证是另一组变量（商户号 / APIv3 密钥 / 商户私钥 / 平台证书），
# 到那时再加在这里 —— 一个都不许有默认值。
PAY_DEV_SECRET=wk-dev-not-a-real-secret
