# 依赖与产物
node_modules/
dist/
*.tsbuildinfo

# 环境变量：真值只在本机，仓库里只留 .env.example
.env
.env.local
.env.*.local
# 生产那份真值（deploy/.env.production）**必须**挡在这里：里面有数据库密码与 JWT 密钥，
# 漏进仓库等于把整套凭证交出去。仓库里只留 deploy/.env.production.example 那份占位。
.env.production

# 部署时生成的东西，不进仓库
# 证书与私钥（真正的机密）
deploy/certs/*
!deploy/certs/.gitkeep
# certbot 的校验目录，里面只有临时文件
deploy/acme/*
!deploy/acme/.gitkeep
# HTTPS 那份是照着 .example 复制出来的，每台服务器域名不一样
deploy/optional/*.conf
!deploy/optional/*.example

# 本地开发库（SQLite）与它生成出来的 schema —— 都是本地物，不进仓库
apps/api/prisma/dev/
*.db
*.db-journal

# 上传的文件（开发期存储驱动写这里）
apps/api/var/

# 日志与系统文件
*.log
npm-debug.log*
.DS_Store
