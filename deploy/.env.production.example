# 复制成 deploy/.env.production 再改。
# ⚠️ 这份**只放占位值**；真值绝不进仓库（.gitignore 已经挡了 .env.production）。
#
# 启动命令要带上它 —— compose 的变量替换和容器内的环境变量用的是同一个文件：
#     docker compose --env-file deploy/.env.production up -d
#
# 值**一律加引号**：deploy/backup-mysql.sh 会 source 这个文件，
# 带空格的值不加引号会被 shell 拆成"赋值 + 一条命令"。

NODE_ENV=production
PORT=3000
APP_VERSION=0.0.0

# 容器里连的是 compose 的服务名 db，不是 localhost。
# （compose 里还会用下面的 MYSQL_* 覆盖这一条，两边保持一致就行）
DATABASE_URL="mysql://wukong:换成密码@db:3306/wukong_math"

MYSQL_ROOT_PASSWORD="换成强密码"
MYSQL_DATABASE="wukong_math"
MYSQL_USER="wukong"
MYSQL_PASSWORD="换成强密码"

# 登录令牌的签名密钥。**上线必须换掉**，而且换掉之后所有人都要重新登录。
# 生成一条：openssl rand -hex 32
JWT_SECRET="换成64位随机串"
AUTH_COOKIE="wk_token"
AUTH_TTL_DAYS="7"

# 上传文件（开发期写本地目录）。生产换 oss 时只改这一行，代码不动。
# 容器里这个路径落在 api_uploads 卷上（见 docker-compose.yml），否则重建即丢。
STORAGE_DRIVER="local"
STORAGE_DIR="/app/apps/api/var/uploads"

# 孤儿上传图清理：学生传了图、又没提交那张切片，图就留在盘上没人引用。
# 间隔 0 = 不起这个活（比如以后挪去独立进程）；宽限期别往短调。
UPLOAD_SWEEP_MINUTES="360"
UPLOAD_SWEEP_MIN_AGE_HOURS="24"

# ---- 支付 ----
# 待支付超时（分钟）
PAY_ORDER_TTL_MINUTES="30"

# **生产环境不要设 PAY_DEV_SECRET** ——
# 那个开发用的假通道在生产环境里根本不会注册，设了只会让人以为这里能付款。
# 真接微信之后，商户凭证（商户号 / APIv3 密钥 / 商户私钥 / 平台证书）加在这一段下面，
# 一个都不许有默认值。
